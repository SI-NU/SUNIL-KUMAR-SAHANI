rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // AET Committee Members
    match /committee_members/{memberId} {
      allow read, write: if true;
    }

    // AET Committee Loans (10% p.a., 3-month cycle)
    match /committee_loans/{loanId} {
      allow read, write: if true;
    }

    // AET Tamper-proof Cryptographic Ledger Transactions
    match /committee_transactions/{txnId} {
      allow read, write: if true;
    }

    // Real-time Committee Notifications
    match /committee_notifications/{notifId} {
      allow read, write: if true;
    }
  }
}
